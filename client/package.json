{
  "name": "@nonce-crypto/client",
  "version": "1.0.0",
  "description": "React/Relay frontend for nonce-based cryptographic authentication",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run relay && tsc && vite build",
    "preview": "vite preview",
    "schema:sync": "node scripts/sync-schema.mjs",
    "relay": "npm run schema:sync && relay-compiler",
    "relay:watch": "relay-compiler --watch",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@apollo/client": "^3.8.0",
    "@types/react-relay": "^16.0.6",
    "babel-plugin-relay": "^16.2.0",
    "graphql": "^16.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-relay": "^16.2.0",
    "relay-runtime": "^16.0.0",
    "vite-plugin-relay": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.1.0",
    "relay-compiler": "^16.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
