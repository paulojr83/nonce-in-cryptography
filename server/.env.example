# Copy this file to server/.env - the server reads it at startup, through
# Node's own env-file parser, so there is no dependency to install. A variable
# already set in the shell wins over the file.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# json-server (the database). If it is not running, the server keeps working
# in memory only and nothing is written to db.json.
DATABASE_URL=http://localhost:3001

# HS256 signing key for session tokens.
# Required in production (min 32 chars); development falls back to a default.
JWT_SECRET=

# Session lifetime (24h)
SESSION_TTL=86400000

# Nonce lifetime (5 min). Shorter narrows the replay window.
NONCE_TTL=300000

# Random bytes per nonce. 32 bytes = 256 bits of entropy.
NONCE_LENGTH=32

# Operations that do NOT validate their nonce, comma separated. Everything is
# protected by default - every query, mutation and subscription, including any
# the schema grows later - so this list is of exceptions, and an empty list
# means there are none. `*` exempts all of them.
#
# An exempt operation has no replay or CSRF protection, and the client stops
# sealing it: a demonstration switch, not a production one.
#
# Today's operations: createTodo, updateTodo, deleteTodo, logout (mutations,
# which spend the nonce) and me, todos, getTodo (reads, which only show it).
NONCE_DISABLED_OPERATIONS=
