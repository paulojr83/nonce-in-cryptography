# Copy this file to server/.env - the server reads it at startup, through
# Node's own env-file parser, so there is no dependency to install. A variable
# already set in the shell wins over the file.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# json-server (the database). If it is not running, the server keeps working
# in memory only and nothing is written to db.json.
DATABASE_URL=http://localhost:3001

# HS256 signing key for session tokens.
# Required in production (min 32 chars); development falls back to a default.
JWT_SECRET=

# Session lifetime (24h)
SESSION_TTL=86400000

# Nonce lifetime (5 min). Shorter narrows the replay window.
NONCE_TTL=300000

# Random bytes per nonce. 32 bytes = 256 bits of entropy.
NONCE_LENGTH=32

# Operations that DO validate their nonce, comma separated - reads and writes
# alike. Mutations spend the nonce; queries only have to show one, so the same
# nonce serves many reads. The list is read literally: anything left out runs
# without a nonce, and the client stops sealing it. `*` means all of them, an
# empty value means none. Delete the line entirely (or ship no .env) and
# everything is protected, which is the default.
# Mutations: createTodo, updateTodo, deleteTodo, logout
# Queries:   me, todos, getTodo
NONCE_ENABLED_OPERATIONS=*
