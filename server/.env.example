# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# json-server (the database). If it is not running, the server keeps working
# in memory only and nothing is written to db.json.
DATABASE_URL=http://localhost:3001

# HS256 signing key for session tokens.
# Required in production (min 32 chars); development falls back to a default.
JWT_SECRET=

# Session lifetime (24h)
SESSION_TTL=86400000

# Nonce lifetime (5 min). Shorter narrows the replay window.
NONCE_TTL=300000

# Random bytes per nonce. 32 bytes = 256 bits of entropy.
NONCE_LENGTH=32
